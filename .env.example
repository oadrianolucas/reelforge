# Copy to .env and fill in. Never commit .env.

# Voice (elevenlabs.io → Profile → API keys)
ELEVENLABS_API_KEY=
# Default voice id when brand.md does not set one
ELEVENLABS_VOICE_ID=

# Images, video models and Gemini video understanding (openrouter.ai/keys)
OPENROUTER_API_KEY=

# TikTok / Instagram scraping for outliers.py and file hosting for host_apify.py (apify.com → Settings → API)
APIFY_TOKEN=

# Optional
FAL_KEY=
